MIZAN_QWEN_LITE_URL=https://<your-modal-endpoint>/generate_lite
MIZAN_CHATBOT_TIMEOUT_SECONDS=600
# Alternative names also supported by the chatbot:
# QWEN_LITE_URL=
# MODAL_QWEN_LITE_URL=

# Required for the "know VAT and ZATCA" RAG feature's online query embedding
# (agents/know_vat_n_zatca/online/retrieval.py) — the deployed BGE-M3
# endpoint from modal-serving/modal_app.py's Embedder class. Without this,
# /api/know-vat-zatca/chat fails every request with "Modal endpoint URL is
# not configured".
MIZAN_EMBEDDER_URL=https://<your-modal-endpoint>/embed
# Alternative name also supported: MODAL_EMBEDDER_URL=

# Required for the "Translate" feature (agents/translation/translate.py) —
# the deployed MADLAD-400 endpoint from modal-serving/modal_app.py's
# Translator class. Without this, /api/translate fails every request.
MIZAN_TRANSLATE_URL=https://<your-modal-endpoint>/translate
# Alternative name also supported: MODAL_TRANSLATE_URL=

# Required — signs/verifies auth JWTs. The app fails to start if this is
# unset. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-random-secret

# Required — Mailgun sends the temp password for /api/auth/forgot-password.
# The app fails to start if any of these are unset.
MAILGUN_API_KEY=your-mailgun-private-api-key
MAILGUN_DOMAIN=your-sending-domain.mailgun.org
MAILGUN_FROM_EMAIL=Mizan.ai <noreply@your-sending-domain.mailgun.org>

# Qdrant — vector store for the "know VAT and ZATCA" RAG feature. Points at
# the qdrant service in docker-compose.yml; override for local (non-Docker)
# dev, e.g. http://localhost:6333.
QDRANT_URL=http://localhost:6333

# Optional — LangSmith tracing for the know_vat_n_zatca LangGraph pipeline.
# If LANGCHAIN_TRACING_V2 is unset/false, tracing is simply skipped — the
# app does not fail to start without these, unlike JWT_SECRET/MAILGUN_*.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=mizan-ai
